{
  "name": "disc-flight-lab",
  "version": "6.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "format": "prettier --write src index.html public/manifest.json tests scripts vite.config.js",
    "native:sync": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/core": "8.5.2",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "fake-indexeddb": "^6.2.4",
    "playwright": "^1.58.0",
    "prettier": "^3.6.2",
    "vite": "8.3.0"
  }
}
